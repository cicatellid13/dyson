    {
      "id": 2104,
      "buildingDetails": {
        "source": "https://dsp-wiki.com/Interstellar_Logistics_Station",
        "checked": "2026-11-08T23:44:18.688260+00:00",
        "fields": [
          {
            "label": "Item types",
            "value": "5 types"
          },
          {
            "label": "Maximum charging power",
            "value": "300 MW"
          },
          {
            "label": "Idle power",
            "value": "60.0 kW"
          },
          {
            "label": "Energy storage",
            "value": "12.0 GJ"
          }
        ]
      },
      "supplementalOverview": [
        [
          {
            "text": "Interstellar Logistics Stations have five item slots, initially holding 10,000 items each and up to 20,000 with research. Maximum charging power is 300 MW; a newly placed, empty station can put a large temporary load on the power grid."
          }
        ],
        [
          {
            "text": "Local supply and demand use drones within a planet; remote supply and demand use vessels between planets. Storage keeps cargo available for belts without requesting or offering it through the corresponding transport mode. Set an output filter on each outgoing belt."
          }
        ],
        [
          {
            "text": "Logistics Carrier "
          },
          {
            "text": "Engine",
            "itemId": 1407
          },
          {
            "text": " level 4 enables vessel warp. A vessel normally takes two "
          },
          {
            "text": "Space Warpers",
            "itemId": 1210
          },
          {
            "text": " for a round trip. Beyond the configured warp distance, requiring warpers prevents departures without them."
          }
        ],
        [
          {
            "text": "Station pairing priority is point-to-point first, then interstellar routes, then groups. Priority Pairing also considers unpaired stations; Exclusive Pairing restricts transport to paired stations; Ignore Pairing bypasses these preferences."
          }
        ],
        [
          {
            "text": "Integrated Logistics research unlocks stacked belt output. Use the technology limit or select a stack count up to the researched limit."
          }
        ]
      ],
      "supplementReference": {
        "source": "https://dsp-wiki.com/Interstellar_Logistics_Station",
        "checked": "2026-11-08T23:44:18.688260+00:00"
      }
    },
