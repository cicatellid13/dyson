      "overview": [
        [
          {
            "text": "Use Holo Beacons to label factories and mark locations visible from planet view and the star map. Linking a beacon to a "
          },
          {
            "text": "Traffic Monitor",
            "itemId": 2030
          },
          {
            "text": " lets its color reflect the monitor’s status."
          }
        ],
        [
          {
            "text": "With Dark Fog beaconing enabled and visibility set to at least the local system, a beacon can attract a relay station to its location."
          }
        ]
      ]
