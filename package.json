{
  "name": "dsp-wiki-desktop",
  "version": "1.2.10",
  "description": "Desktop client for the Dyson Sphere Program Fandom wiki",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm test && vite build && electron-builder",
    "build:dir": "npm run typecheck && npm test && vite build && electron-builder --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --test scripts/catalog.test.mjs scripts/design.test.mjs && tsx --test scripts/persistence.test.ts scripts/updates.test.ts",
    "data:refresh": "python3 scripts/import-wiki.py",
    "db:seed": "tsx scripts/seed-database.ts"
  },
  "dependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "dotenv": "^18.0.8",
    "electron-updater": "^6.6.2",
    "mongodb": "^6.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.dsp.wiki.desktop",
    "productName": "DSP Fieldguide",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.reference",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "DSP-Fieldguide-Setup.exe"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "cicatellid13",
        "repo": "dyson",
        "releaseType": "release"
      }
    ]
  }
}
